// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id             String         @id @default(cuid())
  name           String
  email          String
  message        String         @db.String(2000)
  phone          String?
  company        String?
  subject        String?
  status         String         @default("NOVO") // NOVO, EM_CONTACTO, PROPOSTA, NEGOCIACAO, CONVERTIDO, PERDIDO, ARQUIVADO
  priority       String         @default("MEDIA") // BAIXA, MEDIA, ALTA, URGENTE
  source         String         @default("site_contact") // site_contact, whatsapp, indicacao, manual
  estimatedValue Float?         @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  read           Boolean        @default(false)
  notes          LeadNote[]
  activities     LeadActivity[]

  @@map("contact_messages")
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("ADMIN")
  avatar       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@map("admin_users")
}

model LeadNote {
  id         String         @id @default(cuid())
  leadId     String
  lead       ContactMessage @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorName String         @default("Administrador")
  content    String         @db.String(2000)
  createdAt  DateTime       @default(now())

  @@map("lead_notes")
}

model LeadActivity {
  id          String         @id @default(cuid())
  leadId      String
  lead        ContactMessage @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String         @default("NOTE") // STATUS_CHANGE, NOTE, WHATSAPP, EMAIL, CALL, MEETING
  description String         @db.String(1000)
  createdAt   DateTime       @default(now())

  @@map("lead_activities")
}

model Client {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  company      String?
  address      String?
  status       String   @default("ATIVO") // ATIVO, INATIVO, POTENCIAL
  totalRevenue Float    @default(0)
  notes        String?  @db.String(2000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("clients")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.String(500)
  content     String    @db.String(10000)
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tags        String[]

  @@map("blog_posts")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.String(1000)
  category    String
  image       String?
  tags        String[]
  featured    Boolean  @default(false)
  liveUrl     String?
  createdAt   DateTime @default(now())

  @@map("projects")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  @@map("newsletter_subscribers")
}
